# Everything a build downloads or produces.
/build/
__pycache__/

# Never committed: game data and signing keys (scripts/validate.py checks the
# whole history for both).
*.wad
*.WAD
*.pem
*.key
*.p12
*.pfx

# Build products live in releases, never in the tree -- and scripts/pages.py's
# checked copies of them, which only the Pages site publishes.
/releases/
*.wasm
*.aot
*.moy.zip
